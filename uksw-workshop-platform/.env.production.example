# PostgreSQL - CHANGE THESE VALUES
POSTGRES_DB=uksw_krs
POSTGRES_USER=krs_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis - CHANGE THIS VALUE
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Aiven Kafka - copy the bootstrap host:port from Aiven Console
KAFKA_BROKERS=YOUR_AIVEN_KAFKA_HOST:YOUR_AIVEN_SASL_PORT
KAFKA_SASL_USERNAME=YOUR_AIVEN_SERVICE_USER
KAFKA_SASL_PASSWORD=YOUR_AIVEN_SERVICE_PASSWORD
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# Application
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
CORS_ORIGIN=*
