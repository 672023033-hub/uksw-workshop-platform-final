# PostgreSQL - CHANGE THESE VALUES
DATABASE_URL=YOUR_NEON_DATABASE_URL

# Redis - CHANGE THIS VALUE
REDIS_ADDR=YOUR_UPSTASH_REDIS_HOST:6379
REDIS_PASSWORD=YOUR_UPSTASH_REDIS_PASSWORD

# Aiven Kafka - copy the bootstrap host:port from Aiven Console
KAFKA_BROKERS=YOUR_AIVEN_KAFKA_HOST:YOUR_AIVEN_PORT
KAFKA_TLS=true
KAFKA_CA_FILE=/etc/secrets/kafka_ca.pem
KAFKA_SASL_USERNAME=YOUR_AIVEN_USERNAME
KAFKA_SASL_PASSWORD=YOUR_AIVEN_PASSWORD
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# Application
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
CORS_ORIGIN=https://YOUR-CLOUDFLARE-DOMAIN.pages.dev
